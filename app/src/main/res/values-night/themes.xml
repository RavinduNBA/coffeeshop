<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Coffeeshop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorDarkSecondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:colorBackground">@color/colorDarkPrimary</item>
        <item name="android:textAppearanceButton">@color/colorDarkPrimary</item>
        <item name="materialButtonStyle">@style/CustomButtonStyle</item>

    </style>
    <style name="TextColor"><item name="android:textColor">@color/white</item></style>

    <style name="CustomButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/black</item>
        <item name="android:backgroundTint">@color/colorDarkSecondary</item>
    </style>
    <style name="CustomButtonStyle2" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">#00FFFFFF</item>
    </style>
    <style name="CustomCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorDarkSecondary</item>
    </style>
    <style name="CustomCardStyleSP" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorDarkSecondary</item>
    </style>
    <style name="CardTextStyle">
        <item name="android:textColor">@color/colorDarkPrimary</item>
    </style>
    <style name="bottomNavStyle">
        <item name="android:background">@color/black</item>
    </style>

    <style name="iconColorStyle">
        <item name="android:backgroundTint">@color/white</item>
    </style>

</resources>